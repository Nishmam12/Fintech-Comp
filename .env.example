# ---------------------------------------------------------------
# Budget Kernel environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# --- Supabase project (Dashboard > Project Settings) ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: safe for browser use, but the dashboard talks to our backend, not Supabase directly.
SUPABASE_PUBLISHABLE_KEY=
# Secret key: server-only, bypasses RLS. Backend/admin scripts only.
SUPABASE_SECRET_KEY=

# --- Postgres connections (Dashboard > Connect) ---
# Kernel needs real transactions + SELECT ... FOR UPDATE, so use the SESSION pooler (port 5432)
# or the direct connection. Do not use the transaction pooler (port 6543) for the kernel.
# Direct host db.<ref>.supabase.co is IPv6-only unless the IPv4 add-on is enabled; the session pooler works over IPv4.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# App schema, and a test schema PER TEAM MEMBER: every test run truncates its test schema,
# so two people sharing one would wipe each other's runs. Use e.g. bk_test_nishmam.
BK_SCHEMA=bk
BK_TEST_SCHEMA=bk_test_<yourname>
# Admin token for bootstrap endpoints (/admin/*). Any long random string; never commit it.
BK_ADMIN_TOKEN=

# --- Model providers (server-side only) ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Inference budget (integer micro-USD) ---
BK_GLOBAL_MONTHLY_CAP_MICRO_USD=9500000

# --- Testnet settlement (Member 3; Base Sepolia ONLY, fresh wallet, never mainnet) ---
SETTLEMENT_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# simulated (default) | testnet. Testnet needs a recipients registry: JSON {"recipient name": "0xaddress"}.
BK_SETTLEMENT_MODE=simulated
BK_SETTLEMENT_RECIPIENTS=
# Optional tx-page prefix for explorer links (default Blockscout). e.g. https://sepolia-explorer.base.org/tx/
BK_EXPLORER_URL=
# API rate limiting (per process; 0 disables a bucket). Trust X-Forwarded-For only behind your own proxy.
BK_RATE_DEFAULT_PER_MIN=120
BK_RATE_MODEL_PER_MIN=30
BK_TRUST_PROXY=0
