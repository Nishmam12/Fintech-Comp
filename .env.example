# Supabase Postgres (direct/session connection, port 5432)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
BK_SCHEMA=bk
BK_TEST_SCHEMA=bk_test

# Model providers (server-side only)
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Inference budget (integer micro-USD)
BK_GLOBAL_MONTHLY_CAP_MICRO_USD=9500000
